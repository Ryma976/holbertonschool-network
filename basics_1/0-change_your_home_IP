#!/usr/bin/env bash
# Script that configures localhost and facebook.com IP resolution in /etc/hosts

# Update 127.0.0.1 localhost to 127.0.0.2 localhost
sed -i 's/127\.0\.0\.1/127.0.0.2/g' /etc/hosts

# Add facebook.com resolution to 8.8.8.8 if not already present
if ! grep -q "facebook.com" /etc/hosts; then
    echo "8.8.8.8 facebook.com" >> /etc/hosts
fi
